    "plugins": [
        {
            "name": "Github Notifications",
            "source": {
                "zip_url": "https://gitlab.com/asmurphy/github-notifications/-/archive/main/github-notifications-main.zip",
                "zip_entry_path": null
            },
            "settings": {
                "showall": "false"
            },
            "secrets": [
                "token"
            ],
            "data_stale_minutes": 15,
            "polling": {
                "polling_url": "https://api.github.com/notifications?all={{ showall }}",
                "polling_verb": "get",
                "polling_header": "authorization:token {{ token }}",
                "polling_body": ""
            }
        },
        {
            "name": "Open-Meteo Hourly Weather Forecast",
            "source": {
                "zip_url": "https://github.com/andi4000/trmnl-open-meteo-weather-forecast/archive/refs/heads/main.zip",
                "zip_entry_path": null
            },
            "settings": {
                "lat": 28.6139,
                "lon": 77.209,
                "lang": "en",
                "unit_temperature": "celsius",
                "date_format_today": "l, d.m.Y",
                "date_format_tomorrow": "l",
                "disp_full_today_max_hours": 7,
                "disp_full_tomorrow_hours": "7,9,11,13,15,17,19",
                "disp_half_vertical_today_max_hours": 5
            },
            "secrets": [],
            "data_stale_minutes": 15,
            "polling": {
                "polling_url": "https://api.open-meteo.com/v1/forecast?latitude={{lat}}&longitude={{lon}}{% if unit_temperature == 'fahrenheit' %}&temperature_unit=fahrenheit{% endif %}&daily=weather_code,sunrise,sunset,temperature_2m_max,temperature_2m_min&hourly=temperature_2m,weather_code,is_day&models=best_match&current=temperature_2m,is_day,weather_code&timezone=auto&forecast_days=3\r\nhttps://andi4000.github.io/weather-app-assets/open-meteo/descriptions.v1.json\nhttps://andi4000.github.io/weather-app-assets/open-meteo/iconsmapping.v1.json\nhttps://andi4000.github.io/weather-app-assets/i18n.json",
                "polling_verb": "get",
                "polling_header": "",
                "polling_body": null
            }
        },
        {
            "name": "Formula 1 Race Weekend",
            "source": {
                "zip_url": "https://github.com/barrymichaeldoyle/GrandPrixPicks/archive/refs/heads/main.zip",
                "zip_entry_path": "GrandPrixPicks-main/apps/trmnl"
            },
            "settings": {
                "units": "metric",
                "theme": "light"
            },
            "secrets": [],
            "data_stale_minutes": 15,
            "polling": {
                "polling_url": "https://grandprixpicks.com/api/trmnl/weekend?tz=Asia/Kolkata&locale=en&units={{ units }}",
                "polling_verb": "get",
                "polling_header": "",
                "polling_body": ""
            }
        },
