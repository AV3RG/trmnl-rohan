# Copy to .env (or run `make init`, which also generates APP_KEY).
LARAPAPER_VERSION=0.47.0
PORT=4567
# URL the iPad uses to reach this machine. Image links in API responses are built from it.
# With `tailscale serve --bg 4567` use the https://<machine>.<tailnet>.ts.net address.
APP_URL=http://192.168.1.20:4567
# Set to * when an HTTPS proxy such as tailscale serve sits in front
TRUSTED_PROXIES=
APP_TIMEZONE=Asia/Kolkata
APP_KEY=
# Spotify plugin: app credentials from developer.spotify.com
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
