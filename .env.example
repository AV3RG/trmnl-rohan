# Copy to .env (or run `make init`, which also generates APP_KEY).
LARAPAPER_VERSION=0.47.0
PORT=4567
# URL the iPad uses to reach this machine. Image links in API responses are built from it.
APP_URL=http://192.168.1.20:4567
APP_TIMEZONE=Asia/Kolkata
APP_KEY=
# Webhook URL of the Machine Health plugin (shown on its page in the admin UI)
MACHINE_HEALTH_WEBHOOK=
# Spotify plugin: app credentials from developer.spotify.com and the plugin webhook URL
SPOTIFY_WEBHOOK=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
