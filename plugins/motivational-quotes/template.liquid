{% comment %}One quote per hour, picked from the list in plugin.json. Add or remove quotes there and redeploy.{% endcomment %}
{% assign hour = "now" | date: "%s" | divided_by: 3600 %}
{% assign index = hour | modulo: quotes.size %}
{% assign quote = quotes[index] %}
{% if quote.text.size < 60 %}{% assign font = 58 %}{% elsif quote.text.size < 100 %}{% assign font = 46 %}{% else %}{% assign font = 36 %}{% endif %}

<div class="view view--{{ size }}">
  <div class="layout layout--col layout--center gap--large" style="padding: 0 40px; text-align: center;">
    <span style="font-size: {{ font }}px; line-height: 1.2; font-weight: 500;">&ldquo;{{ quote.text }}&rdquo;</span>
    <span class="title">{{ quote.author }}</span>
  </div>

  <div class="title_bar">
    <span class="title">Motivation</span>
  </div>
</div>
